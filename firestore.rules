rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function staff() {
      return signedIn() && role() in ['technician', 'admin'];
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'student';
      allow read: if signedIn() && (request.auth.uid == userId || staff());
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /labs/{labId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && role() == 'admin';
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pendiente'
        && request.resource.data.urgency in ['baja', 'media', 'alta'];
      allow read: if signedIn()
        && (resource.data.createdBy == request.auth.uid || staff());
      allow update: if staff()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.status in ['pendiente', 'enAtencion', 'resuelto'];
      allow delete: if signedIn() && role() == 'admin';

      match /messages/{messageId} {
        function canAccessReport() {
          let report = get(/databases/$(database)/documents/reports/$(reportId));
          return signedIn()
            && (report.data.createdBy == request.auth.uid || staff());
        }

        allow read: if canAccessReport();
        allow create: if canAccessReport()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'body', 'sentAt'
          ]);
        allow update, delete: if false;
      }
    }
  }
}